# ============================================
# CONFIGURACIÓN BD - PostgreSQL + PostgREST
# ============================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_pass
POSTGRES_DB=productividad_corporativa
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# PostgREST API
PGRST_DB_URI=postgresql://api_user:api_pass@postgres:5432/productividad_corporativa
PGRST_DB_SCHEMA=public
PGRST_DB_ANON_ROLE=api_user
PGRST_JWT_SECRET=your-secret-key-change-in-production
PGRST_OPENAPI_SERVER_PROXY_URL=http://localhost:3000
POSTGREST_PORT=3000

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# Usuario API (para aplicaciones)
API_USER=api_user
API_PASSWORD=api_pass

# Paths
SQL_SCHEMA_FILE=./sql/schema_postgres.sql
SQL_DATA_FILE=./sql/cargar_datos_postgres.sql

# Backups
BACKUP_DIR=./backups
BACKUP_SCHEDULE="0 2 * * *"  # Diario 2am

# Logs
LOG_DIR=./logs
